    {
      "name": "5. Task 2 - tampered token",
      "item": [
        {
          "name": "Step 4 - Add nurse with modified token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test\",\n  \"username\": \"{{studentNo}}\",\n  \"password\": \"{{studentNo}}\",\n  \"role\": \"NURSE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tamperedToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Changes role PATIENT -> ADMIN in the payload and keeps the original signature",
                  "const [header, payload, signature] = pm.collectionVariables.get('patientToken').split('.');",
                  "const json = JSON.parse(CryptoJS.enc.Base64.parse(payload.replace(/-/g,'+').replace(/_/g,'/') + '==='.slice((payload.length + 3) % 4)).toString(CryptoJS.enc.Utf8));",
                  "json.role = 'ADMIN';",
                  "const newPayload = CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(JSON.stringify(json))).replace(/=+$/,'').replace(/\\+/g,'-').replace(/\\//g,'_');",
                  "pm.collectionVariables.set('tamperedToken', header + '.' + newPayload + '.' + signature);"
                ]
              }
            }
          ]
        },
        {
          "name": "Step 5 - View patients with modified token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/patients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "patients"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tamperedToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
